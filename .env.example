# =============================================================
# IT4997-FE — Biến môi trường (mẫu). Copy thành `.env`.
# =============================================================

# Origin của backend (KHÔNG kèm /api). BE chạy mặc định cổng 4001.
# Prod: https://<api-domain>
VITE_ENDPOINT="http://localhost:4001"

# Cổng dev của Vite (vite.config đọc VITE_PORT, mặc định 5173).
# Nên khớp với WEB_URL / FRONTEND_URL bên backend.
VITE_PORT=5000
